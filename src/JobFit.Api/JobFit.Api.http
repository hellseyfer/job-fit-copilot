@JobFit.Api_HostAddress = http://localhost:5000

GET {{JobFit.Api_HostAddress}}/health

###

GET {{JobFit.Api_HostAddress}}/alive

###
POST {{JobFit.Api_HostAddress}}/api/requirements/extract
Content-Type: application/json

{
  "jobPosting": "Senior Backend Engineer at Acme. Requirements: 5+ years of C# and .NET, experience with Docker and PostgreSQL, fluent English. Nice to have: Kubernetes, Terraform."
}

###
PUT {{JobFit.Api_HostAddress}}/api/knowledge/documents/cv
Content-Type: application/json

{
  "kind": "cv",
  "title": "Jane Doe CV",
  "content": "# Experience\n\n## Acme (2020-2025)\n\nBuilt payment APIs in C# and .NET 8 on PostgreSQL, deployed with Docker.\n\n# Skills\n\nC#, .NET, PostgreSQL, Docker, Kubernetes."
}

###
GET {{JobFit.Api_HostAddress}}/api/knowledge/documents/cv/chunks

###
POST {{JobFit.Api_HostAddress}}/api/evidence/search
Content-Type: application/json

{
  "requirements": [
    { "id": "req-1", "description": "5+ years of C# and .NET" },
    { "id": "req-2", "description": "Kubernetes" }
  ],
  "kind": "cv",
  "top": 2
}

###
POST {{JobFit.Api_HostAddress}}/api/fit/score
Content-Type: application/json

{
  "requirements": [
    { "id": "req-1", "description": "5+ years of C# and .NET", "importance": "must-have" },
    { "id": "req-2", "description": "Kubernetes", "importance": "nice-to-have" }
  ],
  "kind": "cv"
}

###
POST {{JobFit.Api_HostAddress}}/api/analyses
