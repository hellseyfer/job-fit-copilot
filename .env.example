# Copy to .env and fill in your values before running `docker compose up --build`
POSTGRES_PASSWORD=postgres

# OpenAI (default)
LLM_PROVIDER=openai
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small

# Local Ollama alternative (run with `docker compose --profile ollama up --build`)
# LLM_PROVIDER=ollama
# CHAT_CONNECTION_STRING=Endpoint=http://ollama:11434;Model=qwen2.5:3b
# EMBEDDINGS_CONNECTION_STRING=Endpoint=http://ollama:11434;Model=nomic-embed-text

# Optional Langfuse OTLP trace export
LANGFUSE_ENDPOINT=https://cloud.langfuse.com/api/public/otel
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
